# Deployment Environment Variables
# These must be set securely in your hosting environment (e.g., Cloud Run Secret Manager)

# Gemini API Key (Required for AI features, Safety Classification, and Evidence RAG)
GEMINI_API_KEY=

# Firebase Client Configuration (Required for client-side Auth and Firestore connection)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server Configuration (Optional, defaults to 3000)
PORT=3000
NODE_ENV=production

# Security Configuration
# Set this to your production domain to strictly limit CORS requests (e.g., https://your-app.com)
ALLOWED_ORIGIN=
